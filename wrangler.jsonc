{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-bias-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "ai-tests.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "PUBLIC_DB",
      "database_name": "ai-bias-public",
      "database_id": "29560e87-1b08-408e-8625-576ba286f741",
      "migrations_dir": "worker/migrations",
      "remote": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "REPORT_GENERATION_QUEUE",
        "queue": "report-generation"
      }
    ],
    "consumers": [
      {
        "queue": "report-generation",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "max_concurrency": 20
      }
    ]
  },
  "observability": {
    "enabled": false
  }
}
